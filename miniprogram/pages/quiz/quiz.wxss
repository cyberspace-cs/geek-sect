/* pages/quiz/quiz.wxss · 暗黑金古风 */
.page {
  padding: 28rpx 28rpx 180rpx;
  background: #0a0a12;
  min-height: 100vh;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.prog {
  font-weight: 800;
  font-size: 30rpx;
  color: #00ff88;
}

.cat-tag {
  font-size: 24rpx;
  color: #8a8a9a;
  font-weight: 700;
}

.progress-bar {
  height: 10rpx;
  background: rgba(255,255,255,.08);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00ff88, #00ccff);
  transition: width .25s;
}

.qcard {
  padding: 36rpx;
  background: #12121e;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,.06);
}

.q-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.q-topic {
  font-size: 24rpx;
  color: #8a8a9a;
}

.q-stem {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8e8f0;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.opts {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255,255,255,.08);
  border-radius: 16rpx;
  background: rgba(255,255,255,.03);
  transition: .15s;
}

.opt-sel {
  border-color: #00ff88;
  background: rgba(226,184,87,.08);
}

.opt-right {
  border-color: #10b981;
  background: rgba(16,185,129,.1);
}

.opt-wrong {
  border-color: #ef4444;
  background: rgba(239,68,68,.1);
}

.opt-abc {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 28rpx;
  background: rgba(226,184,87,.15);
  color: #00ff88;
}

.opt-sel .opt-abc {
  background: #00ff88;
  color: #12121e;
}

.opt-right .opt-abc {
  background: #10b981;
  color: #fff;
}

.opt-wrong .opt-abc {
  background: #ef4444;
  color: #fff;
}

.opt-txt {
  font-size: 30rpx;
  flex: 1;
  color: #b0b0c0;
}

/* 墨教练点评 */
.coach-comment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: rgba(226,184,87,.08);
  border: 1rpx solid rgba(226,184,87,.25);
  border-radius: 16rpx;
}

.coach-avatar-mini {
  font-size: 36rpx;
}

.coach-text {
  flex: 1;
  font-size: 26rpx;
  color: #00ff88;
  font-style: italic;
}

.exp-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #12121e;
  background: #00ff88;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* 解析 */
.explain {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed rgba(255,255,255,.1);
}

.exp-title {
  font-weight: 800;
  font-size: 28rpx;
  color: #00ff88;
  margin-bottom: 12rpx;
}

.exp-body {
  font-size: 28rpx;
  color: #b0b0c0;
  line-height: 1.7;
}

.exp-actions {
  margin-top: 24rpx;
}

.mini-btn {
  display: inline-block;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  background: rgba(226,184,87,.15);
  color: #00ff88;
  font-weight: 700;
}

.added {
  font-size: 26rpx;
  color: #10b981;
  font-weight: 700;
}

/* 底部操作栏 */
.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26,26,46,.95);
  backdrop-filter: blur(10rpx);
  border-top: 1rpx solid rgba(255,255,255,.06);
}

.foot .btn {
  flex: 1;
}

.loading {
  text-align: center;
  color: #8a8a9a;
  padding: 120rpx 0;
  font-size: 28rpx;
}
