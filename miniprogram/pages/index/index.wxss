/* pages/index/index.wxss · 极客宗 · 赛博朋克风 */
.page {
  padding: 0 24rpx 60rpx;
  background: #0a0a12;
  min-height: 100vh;
}

/* 宗主问候区 */
.hero {
  background: linear-gradient(180deg, #12121e 0%, #0a0a12 100%);
  border-radius: 0 0 32rpx 32rpx;
  padding: 40rpx 32rpx 36rpx;
  margin: 0 -24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,255,136,.15);
}

.coach-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.coach-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00ff88, #00ccff);
  border: 2rpx solid #00ff88;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 0 30rpx rgba(0,255,136,.3);
}

.coach-info {
  flex: 1;
}

.coach-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #00ff88;
}

.coach-title {
  font-size: 24rpx;
  color: #666;
  font-weight: 400;
}

.coach-line {
  font-size: 26rpx;
  color: #b0b0c0;
  margin-top: 8rpx;
  font-style: italic;
}

/* 境界卡片 */
.realm-card {
  background: rgba(0,255,136,.05);
  border: 1rpx solid rgba(0,255,136,.2);
  border-radius: 20rpx;
  padding: 28rpx;
}

.realm-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.realm-badge {
  font-size: 30rpx;
  font-weight: 700;
  padding: 6rpx 24rpx;
  border: 1rpx solid #00ff88;
  border-radius: 999rpx;
  background: rgba(0,255,136,.1);
  color: #00ff88;
}

.realm-exp {
  font-size: 26rpx;
  color: #b0b0c0;
}

.exp-bar {
  height: 12rpx;
  background: rgba(255,255,255,.08);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.exp-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width .6s ease;
  background: linear-gradient(90deg, #00ff88, #00ccff);
  box-shadow: 0 0 12rpx rgba(0,255,136,.5);
}

.realm-desc {
  font-size: 22rpx;
  color: #666;
}

/* 统计行 */
.stats-row {
  display: flex;
  align-items: center;
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(255,255,255,.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #00ff88;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,.08);
}

/* 区域标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8e8f0;
  margin: 0 8rpx 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #00ff88;
}

/* 修炼区域卡片 */
.area-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.area-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255,255,255,.06);
  transition: all .2s;
}

.area-card:active {
  transform: scale(.98);
  border-color: rgba(0,255,136,.4);
}

.area-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.area-meta {
  flex: 1;
}

.area-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8e8f0;
}

.area-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.area-count {
  font-size: 26rpx;
  font-weight: 600;
  color: #00ff88;
}

/* 进阶功能卡片 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #12121e;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.06);
}

.feature-card:active {
  border-color: rgba(0,255,136,.4);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(0,255,136,.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.feature-body {
  flex: 1;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8e8f0;
}

.feature-desc {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.feature-arrow {
  font-size: 36rpx;
  color: #444;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #444;
  margin-top: 48rpx;
  letter-spacing: 4rpx;
}
