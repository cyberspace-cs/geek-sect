/* pages/exam/exam.wxss */
.page {
  padding: 24rpx;
  background: #0a0a12;
  min-height: 100vh;
}

.stage-home .exam-hero {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.exam-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.exam-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #00ff88;
}

.exam-desc {
  font-size: 26rpx;
  color: #8a8a9a;
  margin-top: 12rpx;
}

.exam-rules {
  display: flex;
  justify-content: space-around;
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.rule-item {
  font-size: 24rpx;
  color: #b0b0c0;
}

.cat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cat-btn {
  background: #12121e;
  border: 1rpx solid rgba(226,184,87,.3);
  color: #e8e8f0;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx;
  border-radius: 16rpx;
  text-align: center;
}

.cat-btn:active {
  background: rgba(226,184,87,.1);
}

/* 倒计时 */
.stage-countdown {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.count-num {
  font-size: 120rpx;
  font-weight: 800;
  color: #00ff88;
}

.count-tip {
  font-size: 28rpx;
  color: #8a8a9a;
  margin-top: 20rpx;
}

/* 答题中 */
.exam-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.exam-progress {
  font-size: 28rpx;
  color: #e8e8f0;
  font-weight: 700;
}

.exam-timer {
  font-size: 28rpx;
  color: #00ff88;
  font-weight: 700;
}

.question-card {
  background: #12121e;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.q-text {
  font-size: 32rpx;
  color: #e8e8f0;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.q-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.q-option {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(255,255,255,.04);
  border-radius: 12rpx;
  border: 1rpx solid transparent;
}

.q-option.selected {
  border-color: #00ff88;
  background: rgba(226,184,87,.08);
}

.opt-label {
  font-weight: 700;
  color: #00ff88;
}

.opt-text {
  flex: 1;
  font-size: 26rpx;
  color: #b0b0c0;
  line-height: 1.5;
}

.exam-nav {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  flex: 1;
  background: #2a2a3e;
  color: #b0b0c0;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: none;
}

.nav-btn.primary {
  background: linear-gradient(135deg, #00ff88, #00ccff);
  color: #12121e;
  font-weight: 700;
}

/* 结果页 */
.stage-result {
  text-align: center;
  padding: 60rpx 0;
}

.result-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 8rpx solid #00ff88;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 40rpx;
}

.result-score {
  font-size: 72rpx;
  font-weight: 800;
  color: #00ff88;
}

.result-label {
  font-size: 24rpx;
  color: #8a8a9a;
}

.result-summary {
  display: flex;
  justify-content: space-around;
  background: #12121e;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-item .num {
  font-size: 36rpx;
  font-weight: 800;
  color: #e8e8f0;
}

.summary-item .label {
  font-size: 22rpx;
  color: #8a8a9a;
  margin-top: 6rpx;
}

.exp-bonus {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(226,184,87,.1);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.exp-text {
  font-size: 28rpx;
  color: #00ff88;
  font-weight: 700;
}

.btn-home {
  background: linear-gradient(135deg, #00ff88, #00ccff);
  color: #12121e;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 24rpx 80rpx;
  border: none;
}
