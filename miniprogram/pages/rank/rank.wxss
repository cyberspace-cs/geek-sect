/* pages/rank/rank.wxss */
.page {
  padding: 24rpx;
  background: #0a0a12;
  min-height: 100vh;
}

.rank-header {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.rank-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #00ff88;
}

.rank-sub {
  font-size: 24rpx;
  color: #8a8a9a;
  margin-top: 8rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #12121e;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #8a8a9a;
  border-radius: 12rpx;
  transition: all .2s;
}

.tab-item.active {
  background: rgba(226,184,87,.15);
  color: #00ff88;
  font-weight: 700;
}

/* 我的排名 */
.my-rank {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(226,184,87,.15), rgba(226,184,87,.05));
  border: 1rpx solid rgba(226,184,87,.3);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.my-rank-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #00ff88;
}

.my-rank-info {
  flex: 1;
}

.my-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8e8f0;
}

.my-realm {
  font-size: 22rpx;
  color: #8a8a9a;
  margin-top: 4rpx;
}

.my-arrow {
  font-size: 36rpx;
  color: #555566;
}

/* 排行榜 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #12121e;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.rank-item.self {
  border: 1rpx solid rgba(226,184,87,.4);
}

.rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #8a8a9a;
  background: rgba(255,255,255,.05);
}

.rank-num.rank-1 { background: linear-gradient(135deg, #ffd700, #ffb700); color: #12121e; }
.rank-num.rank-2 { background: linear-gradient(135deg, #c0c0c0, #a8a8a8); color: #12121e; }
.rank-num.rank-3 { background: linear-gradient(135deg, #cd7f32, #b87333); color: #12121e; }

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.rank-body {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8e8f0;
}

.rank-realm {
  font-size: 22rpx;
  color: #8a8a9a;
  margin-top: 4rpx;
}

.rank-exp {
  font-size: 24rpx;
  color: #00ff88;
  font-weight: 600;
}
