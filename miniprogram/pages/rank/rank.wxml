<!--pages/rank/rank.wxml · 论道堂-->
<view class="page">

  <view class="rank-header">
    <view class="rank-title">论道堂</view>
    <view class="rank-sub">极客宗弟子修为排行榜</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{tab === 'week' ? 'active' : ''}}" bindtap="switchTab" data-tab="week">本周榜</view>
    <view class="tab-item {{tab === 'total' ? 'active' : ''}}" bindtap="switchTab" data-tab="total">总榜</view>
    <view class="tab-item {{tab === 'friends' ? 'active' : ''}}" bindtap="switchTab" data-tab="friends">好友榜</view>
  </view>

  <!-- 我的排名 -->
  <view class="my-rank">
    <view class="my-rank-num">第 {{myRank}} 名</view>
    <view class="my-rank-info">
      <view class="my-name">你</view>
      <view class="my-realm">秀才 · 120 修为</view>
    </view>
    <view class="my-arrow">›</view>
  </view>

  <!-- 排行榜列表 -->
  <view class="rank-list">
    <view class="rank-item {{item.isSelf ? 'self' : ''}}" wx:for="{{rankList}}" wx:key="name">
      <view class="rank-num rank-{{item.rank}}">{{item.rank}}</view>
      <view class="rank-avatar">{{item.avatar}}</view>
      <view class="rank-body">
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-realm">{{item.realm}}</view>
      </view>
      <view class="rank-exp">{{item.exp}} 修为</view>
    </view>
  </view>

</view>
