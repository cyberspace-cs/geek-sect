/* pages/wrong/wrong.wxss · 心魔录 */
.page {
  padding: 28rpx;
  background: #0a0a12;
  min-height: 100vh;
}

.head {
  margin-bottom: 28rpx;
}

.h-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #e8e8f0;
}

.h-sub {
  font-size: 24rpx;
  color: #8a8a9a;
  margin-top: 6rpx;
}

/* 概览统计 */
.overview {
  display: flex;
  align-items: center;
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #00ff88;
}

.ov-label {
  font-size: 22rpx;
  color: #8a8a9a;
  margin-top: 6rpx;
}

.ov-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,.08);
}

/* 类型分布 */
.type-chart {
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #e8e8f0;
  margin-bottom: 20rpx;
}

.bar-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.bar-label {
  width: 120rpx;
  font-size: 22rpx;
  color: #b0b0c0;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.bar-num {
  width: 70rpx;
  text-align: right;
  font-size: 22rpx;
  color: #e8e8f0;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 140rpx 0;
}

.empty-ico {
  font-size: 96rpx;
}

.empty-t {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8e8f0;
  margin-top: 20rpx;
}

.empty-d {
  font-size: 24rpx;
  color: #8a8a9a;
  margin-top: 10rpx;
}

.wlist {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wcard {
  background: #12121e;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(239,68,68,.2);
}

.w-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.tag.tag-danger {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(239,68,68,.15);
  color: #ef4444;
}

.w-topic {
  font-size: 24rpx;
  color: #8a8a9a;
}

.w-stem {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8e8f0;
  line-height: 1.55;
}

.w-src {
  font-size: 22rpx;
  color: #555566;
  margin-top: 14rpx;
}

.w-action {
  margin-top: 16rpx;
}

.break-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  background: rgba(239,68,68,.15);
  color: #ef4444;
  border: 1rpx solid rgba(239,68,68,.3);
}
